# Matchmaker LLM credentials. Model selection is centralized in Server/.env.
LLM_API_KEY=
LLM_BASE_URL=
EVENT_RELEVANCE_MAX_PER_USER=3
EVENT_RELEVANCE_MIN_SIMILARITY=0.68
EVENT_AVOIDANCE_MIN_SIMILARITY=0.74

# Neo4j memory / feedback
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Must match Social; code clamps it to 1..8 to keep writes bounded.
DURABLE_MEMORY_MAX_CANDIDATES_PER_MESSAGE=6

# Candidate ranking policy
MATCH_GLOBAL_RULE_LIMIT=2
MATCH_GLOBAL_RULE_CHAR_LIMIT=30
MATCH_GLOBAL_RULE_SIMILARITY_THRESHOLD=0.38

# Semantic Related-Interest Matching v1: OFF until explicit deployment approval.
MATCH_RELATED_INTEREST_ENABLED=off
# Canary activation also requires MATCH_PREFERENCE_SEMANTIC_MODE=active and
# MATCH_RELATED_INTEREST_CANARY_USER_IDS in the shared start_all.sh environment.
# Cohort: 2..10 distinct stable IDs in JSON (two-account compatibility;
# Phase 2 activates only 5..10 explicitly confirmed, v2-ready owners). Absent = disabled.
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-2
