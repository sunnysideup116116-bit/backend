# Copy these feature settings into Server/.env. Existing GOOGLE_API_KEYS1,
# GOOGLE_API_KEYS2, ... values are discovered and rotated automatically.
VOICE_REGISTRATION_ENABLED=on
VOICE_LOCAL_RATE_LIMIT_ENABLED=off
VOICE_REGISTRATION_THINKING_LEVEL=low
VOICE_SILENCE_DURATION_MS=500
VOICE_MAX_SESSION_SECONDS=120
VOICE_TICKET_TTL_SECONDS=60
VOICE_KEY_COOLDOWN_SECONDS=60
VOICE_RATE_LIMIT_PER_10_MINUTES=3
VOICE_RATE_LIMIT_PER_DAY=10
VOICE_RATE_LIMIT_GLOBAL_CONCURRENCY=4
VOICE_CONSENT_VERSION=free-tier-voice-v1
