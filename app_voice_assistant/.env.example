VOICE_APP_ENABLED=on
VOICE_APP_DEMO_ONLY=on
VOICE_APP_GEMINI_FALLBACK_ENABLED=on
VOICE_APP_TEST_USER_IDS=test-user-id,seed_user_01,seed_user_04
VOICE_APP_TEXT_MODEL=gemini-3.1-flash-lite
VOICE_APP_LIVE_MODEL=gemini-3.8-live
VOICE_APP_TTS_MODEL=gemini-3.1-flash-tts-preview
VOICE_APP_TTS_VOICE=Achird
VOICE_APP_CONSENT_VERSION=demo-free-gemini-live-ollama-memory-v1
VOICE_APP_MAX_SESSION_SECONDS=600
VOICE_APP_TICKET_TTL_SECONDS=60
VOICE_APP_KEY_COOLDOWN_SECONDS=60
VOICE_APP_PER_10_MINUTES=6
VOICE_APP_PER_DAY=30
VOICE_APP_GLOBAL_CONCURRENCY=4
VOICE_APP_TTS_PER_DAY=60

# Direct Gemini Live template mode uses a small domain-level tool surface and
# keeps simple reads/navigation on the low-latency path. Legacy and proxy remain
# available as fallbacks while the template is verified.
VOICE_APP_TOOL_ROUTING_MODE=template
VOICE_APP_PROXY_USER_IDS=
VOICE_APP_TASKS_ENABLED=on
VOICE_APP_TASK_WORKERS=4
VOICE_APP_TASK_PER_USER_CONCURRENCY=3

# Rolling voice-session memory. The Appwrite endpoint is deliberately private;
# public DNS names are rejected by the runtime and migration tool.
VOICE_MEMORY_ENABLED=on
APPWRITE_INTERNAL_ENDPOINT=https://127.0.0.1/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
VOICE_MEMORY_PROFILE_DATABASE_ID=dating_db
VOICE_MEMORY_PROFILE_COLLECTION_ID=user_profiles
VOICE_MEMORY_DATABASE_ID=voice_memory
VOICE_MEMORY_COLLECTION_ID=voice_session_memories
# Reuses OLLAMA_HOST and OLLAMA_API_KEY from the existing Server configuration.
VOICE_MEMORY_OLLAMA_MODEL=deepseek-v4-flash:cloud
VOICE_MEMORY_APPWRITE_TIMEOUT_SECONDS=5
VOICE_MEMORY_OLLAMA_TIMEOUT_SECONDS=20

# Current conditions. If the dedicated keys are empty, the existing restricted
# GOOGLE_PLACES_SERVER_API_KEY is reused; it must allow Places, Weather and Air
# Quality APIs. A valid location triggers both current-condition APIs every time.
VOICE_WEATHER_ENABLED=on
GOOGLE_WEATHER_GEOCODING_API_KEY=
GOOGLE_WEATHER_API_KEY=
GOOGLE_AIR_QUALITY_API_KEY=
VOICE_WEATHER_TIMEOUT_SECONDS=10
