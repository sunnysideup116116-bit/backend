[Unit]
Description=Ayue Backend (Social, Matchmaker, Risk, Guardrail)
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/sunny/桌面/Graduate_Project/.worktrees/active-release
ExecStart=/home/sunny/桌面/Graduate_Project/.worktrees/active-release/start_all.sh openrouter
Environment=HOME=/home/sunny
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/sunny/.local/bin
Environment=AYUE_SHUTDOWN_TIMEOUT_SECONDS=30
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=75
KillMode=mixed
TimeoutStopSec=45s

[Install]
WantedBy=default.target
