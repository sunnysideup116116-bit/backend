# Core storage
MONGO_URI=mongodb://127.0.0.1:27017

# Public/Private Ayue chat provider
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=deepseek-v4-flash:cloud
OLLAMA_FAST_CHAT_MODEL=

# Embeddings
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-2

# Public Ayue V2 rollout
AYUE_AGENT_V2_MODE=on
AYUE_AGENT_V2_USER_ALLOWLIST=
AYUE_AGENT_MAX_STEPS=3
AYUE_DEFAULT_TIMEZONE=Asia/Taipei

# Owner-only profile extraction
AYUE_PROFILE_SKILLS_MODE=on
AYUE_PROFILE_SKILLS_USER_ALLOWLIST=

# Private mediator V2
AYUE_PRIVATE_AGENTIC_MODE=on
AYUE_PRIVATE_AGENTIC_USER_ALLOWLIST=

# Optional web search
TAVILY_API_KEY=
TAVILY_PROJECT=

# Optional system-only celebration GIFs (never exposed as an agent tool)
GIPHY_API_KEY=
GIPHY_GIF_ENABLED=on

# Optional nearby places and distance tools
AYUE_MAPS_ENABLED=on
AYUE_MAPS_MONGO_CACHE=off
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
OSM_USER_AGENT=AyueDatingDemo/1.0 (educational demo)

# Optional Google Places cards. Keep server/browser keys separate and restrict
# the browser key by HTTP referrer and the server key to the Places API.
AYUE_GOOGLE_PLACE_CARDS_ENABLED=off
GOOGLE_PLACES_SERVER_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=

# Match candidate pre-filter
MATCH_AGENT_CANDIDATE_LIMIT=3
MATCH_VECTOR_QUALIFICATION_MIN=0.55
