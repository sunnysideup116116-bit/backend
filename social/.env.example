# Core storage
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=profiling_db

# Appwrite Realtime and Messaging. Non-loopback endpoints must use HTTPS.
APPWRITE_ENDPOINT=https://appwrite.misproject.us.ci/v1
# Optional host-local route used by server-side Appwrite calls. Loopback TLS
# may use the machine's self-signed proxy certificate; public TLS stays strict.
APPWRITE_INTERNAL_ENDPOINT=https://127.0.0.1/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_PUSH_ENABLED=false
APPWRITE_FCM_PROVIDER_ID=6a81bf000036a6eaf5e0
# Destructive Demo buttons are disabled unless explicitly enabled locally.
DEMO_DESTRUCTIVE_TOOLS_ENABLED=off

# Pair-chat risk policy. Risk outages fail open; only an explicit `blocked`
# assessment prevents receiver-visible persistence.
RISK_SERVICE_URL=http://127.0.0.1:8001
RISK_TIMEOUT_SEC=40

# Public/Private Ayue chat provider
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=deepseek-v4-flash:cloud
OLLAMA_FAST_CHAT_MODEL=

# Optional Public V3 per-owner overrides. Empty/unset keeps the original tier:
# fast = planner/places/match/relationship/profile; main = calendar/web/synthesizer.
AYUE_OLLAMA_PLANNER_MODEL=
AYUE_OLLAMA_CALENDAR_MODEL=
AYUE_OLLAMA_PLACES_MODEL=
AYUE_OLLAMA_MATCH_MODEL=
AYUE_OLLAMA_RELATIONSHIP_MODEL=
AYUE_OLLAMA_PROFILE_MODEL=
AYUE_OLLAMA_WEB_MODEL=
AYUE_OLLAMA_SYNTHESIZER_MODEL=
AYUE_GPT_PLANNER_MODEL=
AYUE_GPT_CALENDAR_MODEL=
AYUE_GPT_PLACES_MODEL=
AYUE_GPT_MATCH_MODEL=
AYUE_GPT_RELATIONSHIP_MODEL=
AYUE_GPT_PROFILE_MODEL=
AYUE_GPT_WEB_MODEL=
AYUE_GPT_SYNTHESIZER_MODEL=
AYUE_OLLAMA_TIMEOUT_SECONDS=30
AYUE_LOCAL_DEBUG_TRACE=off
AYUE_RUNTIME_MODEL_SETTINGS_TOKEN=
AYUE_ALLOWED_RUNTIME_MODELS=

# Embeddings
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-2

AYUE_DEFAULT_TIMEZONE=Asia/Taipei
AYUE_CALENDAR_STATE_MONGO=on

# Optional owner-authenticated, read-only Google Calendar integration.
# Keep off until OAuth credentials are installed and the test owner allowlist
# has been reviewed. The scope is hard-coded to calendar.events.owned.readonly.
AYUE_GOOGLE_CALENDAR_ENABLED=off
AYUE_GOOGLE_CALENDAR_ALLOWED_USER_IDS=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Fernet key generated and stored only as a deployment secret.
GOOGLE_CALENDAR_TOKEN_KEY=
GOOGLE_CALENDAR_REDIRECT_URI=https://service.misproject.us.ci/api/integrations/google-calendar/callback

# Owner-only profile extraction
AYUE_PROFILE_SKILLS_MODE=on
AYUE_PROFILE_SKILLS_USER_ALLOWLIST=
AYUE_PROACTIVE_FOLLOWUP_MODE=shadow
AYUE_RELATIONSHIP_MEMORY_MODE=shadow
AYUE_MEMORY_OUTBOX_WORKER_ENABLED=on
AYUE_MEMORY_OUTBOX_POLL_SECONDS=30
AYUE_CONVERSATION_COMPACTION_MODE=off
AYUE_CONVERSATION_CONTEXT_MODE=off
AYUE_CONVERSATION_CONTEXT_USER_ALLOWLIST=

# Optional web search
TAVILY_API_KEY=
TAVILY_PROJECT=

# Public Event discovery. Keep the scheduled job off until manual output has
# been reviewed in the target environment.
# Production weekly cycle: Monday discovery -> expired-event cleanup -> invitation scan.
# Keep off during manual testing; event_worker.py must be running when enabled.
EVENT_WEEKLY_CYCLE_ENABLED=off
# Persist Event cards even when users are offline; restart start_all.sh to apply.
EVENT_DELIVERY_WORKER_ENABLED=on
# MongoDB Change Stream is the primary worker wake-up path. This interval is
# only used to reconcile missed notifications or recover from stream outages.
EVENT_WORKER_RECONCILE_SECONDS=60
EVENT_CHAT_PRIORITY_MAX_WAIT_SECONDS=600
EVENT_DISCOVERY_REGION=高雄
EVENT_DISCOVERY_WINDOW_DAYS=30
EVENT_DISCOVERY_CATEGORIES=市集,音樂,運動,節慶,美食
EVENT_DISCOVERY_WEEKDAY=0
EVENT_DISCOVERY_HOUR=8
EVENT_WEEKLY_RELEVANCE_WAIT_SECONDS=900
EVENT_WEEKLY_RELEVANCE_POLL_SECONDS=10
EVENT_INGEST_TIMEOUT_SECONDS=600
# Event writes use deterministic MERGE keys, so transient retries are idempotent.
EVENT_INGEST_MAX_ATTEMPTS=2
EVENT_ADAPTIVE_SUPPLEMENTAL_SEARCH=on
EVENT_DISCOVERY_MIN_PER_CATEGORY=4
EVENT_DISCOVERY_TARGET_PER_CATEGORY=6
EVENT_ADAPTIVE_SUPPLEMENTAL_MAX_CATEGORIES=6
EVENT_SUPPLEMENTAL_INGEST_TIMEOUT_SECONDS=180
EVENT_URL_HEALTHCHECK_ENABLED=on
CONCEPT_EMBEDDING_WORKER_ENABLED=on
# Manual discovery does not send invitations. The weekly cycle invokes its
# invitation scan explicitly after every category has finished.
EVENT_OPPORTUNITY_AUTO_SCAN_ENABLED=off
EVENT_OPPORTUNITY_MAX_PROPOSALS_PER_SCAN=3
# Weekly cycles continue across batches until the snapshotted population is processed.
# This is a batch limit, not the weekly total. Manual scans retain their bounded behavior.
EVENT_OPPORTUNITY_MAX_USERS_PER_SCAN=30
EVENT_PAIR_DECLINE_COOLDOWN_DAYS=7
EVENT_LIFECYCLE_WORKER_ENABLED=on
EVENT_PROPOSAL_EXPIRY_INTERVAL_SECONDS=300
EVENT_GRAPH_CLEANUP_INTERVAL_SECONDS=86400
EVENT_PROPOSAL_EXPIRY_LEAD_SECONDS=0

# Optional system-only celebration GIFs (never exposed as an agent tool).
# The server rotates happy/congratulations/yay/celebration searches and avoids recent URLs.
GIPHY_API_KEY=
GIPHY_GIF_ENABLED=on

# Optional nearby places and distance tools
AYUE_MAPS_ENABLED=on
AYUE_MAPS_MONGO_CACHE=off
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
OSM_USER_AGENT=AyueDatingDemo/1.0 (educational demo)

# Optional Google Places cards. Keep server/browser keys separate and restrict
# the browser key by HTTP referrer and the server key to the Places API.
# Verify current Google pricing and quota before enabling. Ordinary searches use
# the bounded base mask; rating/count and current-opening-hours fields are only
# requested when the Places task explicitly asks for those enrichments.
AYUE_GOOGLE_PLACE_CARDS_ENABLED=off
# Public place-card rendering is off for the current demo; candidate refs and
# typed place evidence remain available internally.
AYUE_PUBLIC_PLACE_CARDS_ENABLED=off
GOOGLE_PLACES_SERVER_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
# Optional photo-media request. Keep off unless the project has explicit quota
# and cost approval; the no-photo place card remains the supported default.
AYUE_GOOGLE_PLACE_PHOTOS_ENABLED=off
# Routes API Compute Routes Essentials for real driving distance/time.
AYUE_GOOGLE_DISTANCE_MATRIX_ENABLED=on

# Match candidate pre-filter
MATCH_AGENT_CANDIDATE_LIMIT=3
MATCH_VECTOR_QUALIFICATION_MIN=0.55
# One local-day (Asia/Taipei) allowance for successful user-initiated
# introductions and a separate allowance for proactive event invitations.
MATCH_ACTIVE_DAILY_LIMIT=3
MATCH_BACKGROUND_DAILY_LIMIT=1
# New installs use pair-scoped multi-card protection. Existing deployments
# should run scripts/migrate_match_multi_indexes.py after a dry-run before
# removing the legacy participant-wide index.
MATCH_MULTI_INDEX_READY=on

# Public V3 sub-agent runtime
AYUE_V3_SIMPLE_CHAT_FAST_PATH=off
# Optional server-anchored Places -> Web bootstrap for casual discovery.
AYUE_V3_WEB_PLACE_BOOTSTRAP_FAST_PATH=off
AYUE_SUBAGENT_MAX_READS=3
AYUE_SUBAGENT_MAX_PARALLEL=2
